
# You may find this .hjson file approach to translations easier for your mod.
# .hjson files contain translations for the language specified in the filename. (Make sure this file is UTF-8 encoded only.)
# The possible languages are: English ("en-US"), German ("de-DE"), Italian ("it-IT"), French ("fr-FR"), Spanish ("es-ES"), Russian ("ru-RU"), Chinese ("zh-Hans"), Portuguese ("pt-BR"), and Polish ("pl-PL")
# Here in ExampleMod we have organized these files in a folder called Localization. A single file per language makes it extremely easy to to integrate and maintain translations.
# Each translation entry in .hjson files contains a key and a value. The key is determined following the rules of JSON [https://www.w3schools.com/js/js_json_syntax.asp]
# The Key automatically inherits "Mods.ModNameHere.", which is useful to know if you want to use substitutions (as seen in the Paper Airplane example) or use Language.GetTextValue or Network text.
# The following are the currently autogenerated keys: ItemName, ItemTooltip, BuffName, BuffDescription, ProjectileName, NPCName, MapObject, and Prefix

Mods: {
	ImmersiveProjector: {
		ItemName: {
			MiniProjector: 微型投影仪
		}

		ItemTooltip: {
			MiniProjector:
				'''
				高度压缩的通用投影仪器
				[c/00FF00:右键交互打开配置界面]
				
				‘什么…这不是饼干’
				'''
		}

		MapObject: {
			MiniProjectorTile: "{$Mods.ImmersiveProjector.ItemName.MiniProjector}"
		}

		Config: {

			Prefabs: 预设
			SelectArea: 区域选择
			Settings: 设置
			Behavior: 行为
			Color: 颜色

			Description0: 预设列表
			Description1: 选择投影区域
			Description2: 投影仪选项
			Description3: 交互行为设置
			Description4: 投影颜色

			Snapping: 选框对齐
			SnappingBlock: 物块
			Flip: 翻转
			FlipN: 不翻转
			FlipH: 左右镜像
			FlipV: 上下镜像
			DoubleClickResetPosition: 双击此处重置范围
			TargetRotation: 旋转目标影像

			CaptureTiles: 拍摄物块
			CaptureTilesN: 无
			CaptureTilesS: 实心物块
			CaptureTilesA: 所有物块

			CaptureWalls: 拍摄墙壁
			CaptureWallsN: 无
			CaptureWallsT: 所有墙壁

			CaptureCreatures: 拍摄实体
			CaptureCreaturesN: 无
			CaptureCreaturesA: 所有实体

			CaptureBlends: 投影混合
			CaptureBlendsD: 默认
			CaptureBlendsA: 颜色叠加

			CaptureLayers: 影像所处层级
			CaptureLayersF: 前景
			CaptureLayersN: 一般
			CaptureLayersBF: 家具后
			CaptureLayersBW: 墙体后

			CaptureLightingSources: 光源选择
			CaptureLightingSourcesS: 原始区域
			CaptureLightingSourcesT: 目标区域 (更快) 
			CaptureLightingSourcesB: 二者之和

			CapturePriority: 层叠优先级
			CapturePriorityToolTip: 重叠的投影间的相互优先级

			CaptureLightFreqency: 光照频率
			CaptureLightFreqencyToolTip: 通过减少光照更新来提升性能

			CaptureFreqency: 更新频率
			CaptureFreqencyToolTip: 通过缓存图像来提升性能 (需要显存)

			CaptureParallax: 视差 
			CaptureParallaxToolTip: 粉色视差线的长度比例

			Red: 红
			Green: 绿
			Blue: 蓝
			ColorR: 基础红色
			ColorG: 基础绿色
			ColorB: 基础蓝色
			ColorH: 色相
			ColorS: 饱和度
			ColorV: 亮度
			Opacity: 不透明度

			CaptureBehavior: 影像触碰玩家时
			CaptureBehaviorN: 无交互
			CaptureBehaviorH: 淡出至一半
			CaptureBehaviorF: 完全淡出
			CaptureBehaviorD: 影像扰动

			CaptureFollowS: 摄像区域跟踪
			CaptureFollowSId: (对象下标)
			CaptureFollowT: 投影区域跟踪
			CaptureFollowTId: (对象下标)
			CaptureFollowN: 不跟踪
			CaptureFollowP: 玩家
			CaptureFollowTN: 城镇NPC
			CaptureFollowB: Boss

			CaptureFilter: 视觉特效
			CaptureFilterN: 无滤镜
			CaptureFilterH: 全息特效

			Cancel: 取消
			Hide: 隐藏
			Confirm: 保存
		}
	}
}
