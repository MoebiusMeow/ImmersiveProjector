# You may find this .hjson file approach to translations easier for your mod.
# .hjson files contain translations for the language specified in the filename. (Make sure this file is UTF-8 encoded only.)
# The possible languages are: English ("en-US"), German ("de-DE"), Italian ("it-IT"), French ("fr-FR"), Spanish ("es-ES"), Russian ("ru-RU"), Chinese ("zh-Hans"), Portuguese ("pt-BR"), and Polish ("pl-PL")
# Here in ExampleMod we have organized these files in a folder called Localization. A single file per language makes it extremely easy to to integrate and maintain translations.
# Each translation entry in .hjson files contains a key and a value. The key is determined following the rules of JSON [https://www.w3schools.com/js/js_json_syntax.asp]
# The Key automatically inherits "Mods.ModNameHere.", which is useful to know if you want to use substitutions (as seen in the Paper Airplane example) or use Language.GetTextValue or Network text.
# The following are the currently autogenerated keys: ItemName, ItemTooltip, BuffName, BuffDescription, ProjectileName, NPCName, MapObject, and Prefix

Mods: {
	ImmersiveProjector: {
		ItemName: {
			MiniProjector: Mini Projector
		}

		ItemTooltip: {
			MiniProjector:
				'''
				A highly compressed projector for general purpose
				[c/00FF00:Interact to config the projector]
				
				‘Wait... This is not a cookie’
				'''
		}

		MapObject: {
			MiniProjectorTile: "{$Mods.ImmersiveProjector.ItemName.MiniProjector}"
		}

		Config: {

			Prefabs: Presets
			SelectArea: Select Area
			Settings: Settings
			Behavior: Behavior
			Color: Color

			Description0: Presets Browser
			Description1: Select projection area
			Description2: Projector Settings
			Description3: Interaction Behavior
			Description4: Projection Color

			Snapping: Snapping
			SnappingBlock: Block
			Flip: Flip
			FlipN: No Flip
			FlipH: Flip Horizontally
			FlipV: Flip Vertically
			DoubleClickResetPosition: Double click here to Reset both areas
			TargetRotation: Rotate Target Area 

			CaptureTiles: Capture Tiles
			CaptureTilesN: None
			CaptureTilesS: Solid tiles only
			CaptureTilesA: All tiles

			CaptureWalls: Capture Walls
			CaptureWallsN: None
			CaptureWallsT: All walls

			CaptureCreatures: Capture Entities
			CaptureCreaturesN: None
			CaptureCreaturesA: All Entities

			CaptureBlends: Blending
			CaptureBlendsD: Default
			CaptureBlendsA: Additive light

			CaptureLayers: Projection Layer
			CaptureLayersF: Foreground
			CaptureLayersN: Normal 
			CaptureLayersBF: Behind furnitures
			CaptureLayersBW: Behind walls 

			CapturePriority: Layer Priority 
			CapturePriorityToolTip: Layer Priority among stacked projections

			CaptureFreqency: Lighting Freqency 
			CaptureFreqencyToolTip: Reduce lighting freqency for higher performance

			CaptureParallax: Parallax 
			CaptureParallaxToolTip: The length of the pink line

			Red: Red
			Green: Green
			Blue: Blue
			ColorH: Hue offset
			ColorS: Saturation offset
			ColorV: Value offset
			Opacity: Opacity

			CaptureBehavior: When players enter
			CaptureBehaviorN: Do nothing
			CaptureBehaviorH: Half-faded
			CaptureBehaviorF: Faded
			CaptureBehaviorD: Distorted

			CaptureFollowS: Source area following
			CaptureFollowSId: (Select index)
			CaptureFollowT: Target area following
			CaptureFollowTId: (Select index)
			CaptureFollowN: Nothing
			CaptureFollowP: A player
			CaptureFollowTN: A town NPC
			CaptureFollowB: A boss

			CaptureFilter: Visual effects
			CaptureFilterN: No Filter 
			CaptureFilterH: Hologram

			Cancel: Cancel
			Hide: Hide
			Confirm: Confim
		}
	}
}
